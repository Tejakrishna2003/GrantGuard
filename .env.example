# ==============================================================================
# GrantPool AI - Environment Configuration Template
# Copy this file to .env before starting the backend
# ==============================================================================

# Server Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Demo Mode (true enables simulated sandbox responses, bypasses keys if absent)
DEMO_MODE=true

# Database
DATABASE_URL=sqlite:///./grantpool.db

# PayPal Developer Sandbox (https://developer.paypal.com)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=AXXXXXXXXXXXXXXX_YOUR_PAYPAL_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=EXXXXXXXXXXXXXXX_YOUR_PAYPAL_SANDBOX_CLIENT_SECRET
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# AI Model (Google Gemini API - https://aistudio.google.com)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash

# Twilio Verify (Optional - Demo mode auto-fills OTP without real phone)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_VERIFY_SERVICE_SID=VAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Emergency Threshold Configuration
DEFAULT_TOLERANCE_PERCENT=10.0
CRISIS_TOLERANCE_PERCENT=35.0
